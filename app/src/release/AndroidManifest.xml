<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The offline/release build declares no network permissions. WorkManager's
      manifest contributes ACCESS_NETWORK_STATE for network-constrained work,
      which this build never schedules (sync is a debug/dev feature and is
      gated behind SyncMode.ONLINE_CLOUD). Remove it so the shipped app stays
      fully offline. The debug build keeps it (see app/src/debug).
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
</manifest>
