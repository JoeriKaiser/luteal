<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug / dev build only: permit cleartext HTTP to a LOCAL folicular server
      for the sync trial (emulator loopback http://10.0.2.2:8080, an
      adb-reversed http://127.0.0.1:8080, or the host's LAN IP). The network
      permissions themselves are declared in the main manifest; the release
      build syncs over HTTPS only and ships no cleartext allowance.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true" />
</manifest>
