<?xml version="1.0" encoding="utf-8"?>
<!--
    Locales offered in the Android per-app language picker. French is listed
    first (in `values-fr/`), Spanish in `values-es/`, and English lives in the
    default `values/` folder as the fallback for unsupported locales. Keep this
    in step with `androidResources.localeFilters` in app/build.gradle.kts.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="fr" />
    <locale android:name="es" />
    <locale android:name="en" />
</locale-config>
