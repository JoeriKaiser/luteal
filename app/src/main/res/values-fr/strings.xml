    <string name="settings_appearance_body">Le thème clair ou sombre suit le réglage de votre appareil.</string>
    <string name="settings_about_title">À propos des estimations</string>
    <string name="settings_about_body">Luteal sépare les observations enregistrées des calculs estimatifs. L’application ne pose aucun diagnostic et ne formule aucune conclusion médicale.</string>
    <string name="settings_test_data_title">Données de démonstration</string>
    <string name="settings_test_data_body">Injectez 3 cycles de test avec observations et symptômes pour tester l’estimation, le journal et le mode Duo sans attendre plusieurs mois.</string>
