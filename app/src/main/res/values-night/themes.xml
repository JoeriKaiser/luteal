<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Same style, dark parent. Without this the theme stayed
      Theme.Material.Light in dark mode, so the cold-start window and the
      Android 12+ splash both flashed light before the dark UI appeared.
    -->
    <style name="Theme.Luteal" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/luteal_window_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">
            @color/luteal_splash_background
        </item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">
            @drawable/ic_splash_icon
        </item>
    </style>
</resources>
