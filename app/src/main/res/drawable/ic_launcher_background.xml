<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background layer.
  Subtle radial gradient provides tactile depth when launchers
  apply parallax motion on touch/drag.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="65"
                android:startColor="#FAF7F1"
                android:endColor="#E3DDD0" />
        </aapt:attr>
    </path>
    <!-- Soft ambient inner halo within the 72dp safe zone -->
    <path
        android:fillColor="#06235B4E"
        android:pathData="M54,20 A34,34 0 1,0 54,88 A34,34 0 1,0 54,20 Z" />
</vector>
