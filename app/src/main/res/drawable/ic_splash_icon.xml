<?xml version="1.0" encoding="utf-8"?>
<!--
  The Luteal mark for the Android 12+ splash screen.

  Single-colour and symmetric, matching the in-app CycleDayRing. The launcher
  icon uses two tones, but on the splash the mark sits alone on a flat
  background where an asymmetric pair reads as a half-filled progress ring.
  The colour is night-qualified so the mark stays legible in both themes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="@color/luteal_splash_mark">
    <!-- Left half -->
    <path
        android:strokeColor="@color/luteal_splash_mark"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M52,26 A28,28 0 0,0 52,82" />
    <!-- Right half -->
    <path
        android:strokeColor="@color/luteal_splash_mark"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M56,26 A28,28 0 0,1 56,82" />
    <!-- Focal node -->
    <path
        android:fillColor="@color/luteal_splash_mark"
        android:pathData="M54,50 A4,4 0 1,1 54,58 A4,4 0 1,1 54,50" />
</vector>
