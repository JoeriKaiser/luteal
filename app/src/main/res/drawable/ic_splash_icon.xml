<?xml version="1.0" encoding="utf-8"?>
<!--
  The Luteal mark for the Android 12+ splash screen.

  Four-arc cardinal ring (Variant 3C) with central anchor.
  The colour is night-qualified so the mark stays legible in both themes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="@color/luteal_splash_mark">
    <!-- Top Arc -->
    <path
        android:strokeColor="@color/luteal_splash_mark"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M39.09,32.70 A26,26 0 0,1 68.91,32.70" />
    <!-- Right Arc -->
    <path
        android:strokeColor="@color/luteal_splash_mark"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M75.30,39.09 A26,26 0 0,1 75.30,68.91" />
    <!-- Bottom Arc -->
    <path
        android:strokeColor="@color/luteal_splash_mark"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M68.91,75.30 A26,26 0 0,1 39.09,75.30" />
    <!-- Left Arc -->
    <path
        android:strokeColor="@color/luteal_splash_mark"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M32.70,68.91 A26,26 0 0,1 32.70,39.09" />
    <!-- Focal node -->
    <path
        android:fillColor="@color/luteal_splash_mark"
        android:pathData="M54,50.5 A3.5,3.5 0 1,1 54,57.5 A3.5,3.5 0 1,1 54,50.5" />
</vector>
